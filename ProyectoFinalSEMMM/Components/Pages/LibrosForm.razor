@page "/libros/editar"
@page "/libros/editar/{Id:int}"
@rendermode InteractiveServer
@inject NavigationManager _navigator
@using ProyectoFinalSEMMM.Modelos
@using ProyectoFinalSEMMM.Repositorios
@inject IRepositorioLibros RepositorioLibros
@inject IRepositorioAutores RepositorioAutores
@inject IRepositorioGeneros RepositorioGeneros
@inject IRepositorioLibros _repositorioLibros
@inject IRepositorioAutores _repositorioAutores
@inject IRepositorioGeneros _repositorioGeneros

<h3>@(Id == null ? "Nuevo Libro" : "Editar Libro")</h3>
<EditForm Model="_libro" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div>
        <label>Título:</label>
        <InputText @bind-Value="_libro.Titulo" class="form-control" />
    </div>
    <div>
        <label>Editorial:</label>
        <InputText @bind-Value="_libro.Editorial" class="form-control" />
    </div>

    <div>
        <label>Año de Publicación:</label>
        <InputNumber @bind-Value="_libro.AnoPublicacion" class="form-control" />
    </div>
    <div>
        <label>Autor:</label>
        <InputSelect @bind-Value="_libro.AutorId" class="form-control">
            <option value="">Seleccione un autor</option>
            @foreach (var autor in _autores)
            {
                <option value="@autor.Id">@autor.Nombre</option>
            }
        </InputSelect>
    </div>
    <div>
        <label>Géneros:</label>
        @foreach (var genero in _generosDisponibles)
        {
            <div>
                <input type="checkbox" value="@genero.Id"
                       @onchange="e => SeleccionarGenero(genero.Id, (bool)((ChangeEventArgs)e).Value)"
                       checked="@generoSeleccionadoIds.Contains(genero.Id)" />
                @genero.Nombre
            </div>
        }
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
    </div>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    private Libro _libro = new();
    private Libro _libroOriginal = new();
    private List<Autor> _autores = new();
    private List<Genero> _generosDisponibles = new();
    private List<int> generoSeleccionadoIds = new();

    protected override async Task OnInitializedAsync()
    {
        _autores = await _repositorioAutores.GetAll();
        _generosDisponibles = await _repositorioGeneros.GetAll();

        if (Id != null)
        {
            var libroExistente = await _repositorioLibros.Get(Id.Value);
            if (libroExistente != null)
            {
                _libro = libroExistente;

                // Clonar para posible cancelación
                _libroOriginal = new Libro
                    {
                        Id = _libro.Id,
                        Titulo = _libro.Titulo,
                        Editorial = _libro.Editorial,
                        AnoPublicacion = _libro.AnoPublicacion,
                        AutorId = _libro.AutorId,
                        Generos = _libro.Generos != null ? new List<Genero>(_libro.Generos) : new List<Genero>()
                 };
                generoSeleccionadoIds = _libro.Generos?.Select(g => g.Id).ToList() ?? new();
            }
        }}
    private async Task Guardar()
    {
        // Asignar géneros seleccionados
        _libro.Generos = _generosDisponibles
            .Where(g => generoSeleccionadoIds.Contains(g.Id))
            .ToList();

        if (Id == null)
        {
            await _repositorioLibros.Add(_libro);
        }
        else
        {
            await _repositorioLibros.Update(_libro.Id, _libro);
        }

        _navigator.NavigateTo("/libros");
    }

    private void Cancelar()
    {
        if (Id == null)
        {
            _navigator.NavigateTo("/libros");
        }
        else
        {
            // Volver a valores originales si está editando
            _libro = new Libro
                {
                    Id = _libroOriginal.Id,
                    Titulo = _libroOriginal.Titulo,
                    Editorial = _libroOriginal.Editorial,
                    AnoPublicacion = _libroOriginal.AnoPublicacion,
                    AutorId = _libroOriginal.AutorId,
                    Generos = _libroOriginal.Generos != null ? new List<Genero>(_libroOriginal.Generos) : new List<Genero>()
                };

            generoSeleccionadoIds = _libro.Generos.Select(g => g.Id).ToList();
            _navigator.NavigateTo("/libros");
        }
    }

    private void SeleccionarGenero(int generoId, bool seleccionado)
    {
        if (seleccionado)
        {
            if (!generoSeleccionadoIds.Contains(generoId))
                generoSeleccionadoIds.Add(generoId);
        }
        else
        {
            generoSeleccionadoIds.Remove(generoId);
        }
    }
}