@page "/libros"
@inject IRepositorioLibros _repositorioLibros
@using ProyectoFinalSEMMM.Repositorios
@inject NavigationManager NavigationManager

<h3>Libros</h3>

<button class="btn btn-primary mb-3" @onclick="CrearNuevo">Nuevo libro</button>

@if (libros == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Título</th>
                <th>Autor</th>
                <th>Año</th>
                <th>Editorial</th>
                <th>Géneros</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var libro in libros)
            {
                <tr>
                    <td>@libro.Titulo</td>
                    <td>@libro.Autor?.Nombre</td>
                    <td>@libro.AnoPublicacion</td>
                    <td>@libro.Editorial</td>
                    <td>
                        @if (libro.Generos != null)
                        {
                            foreach (var genero in libro.Generos)
                            {
                                <span class="badge bg-secondary d-block mb-1">@genero.Nombre</span>
                            }
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-primary me-1" @onclick="() => Editar(libro.Id)">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => Borrar(libro.Id)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Libro>? libros;

    protected override async Task OnInitializedAsync()
    {
        libros = await _repositorioLibros.GetAll();
    }

    private void CrearNuevo()
    {
        NavigationManager.NavigateTo("/libros/nuevo");
    }

    private void Editar(int id)
    {
        NavigationManager.NavigateTo($"/libros/editar/{id}");
    }

    private async Task Borrar(int id)
    {
        await _repositorioLibros.Delete(id);
        libros = await _repositorioLibros.GetAll();
    }
}